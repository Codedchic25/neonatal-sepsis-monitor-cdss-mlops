# ==============================================================================
# Sepsis Monitor AI - Team Environment Template (PUBLIC / PORTFOLIO-READY)
# ==============================================================================

# Application Operational Modes
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# Cryptographic Integrity
SECRET_KEY=your_secure_django_or_fastapi_secret_key_placeholder

# Persistent Database Architecture
# For local dev: sqlite:///sepsis_neonatal.db
# For Docker Production deployment: sqlite:////app/data/sepsis_neonatal.db
DATABASE_URL=sqlite:///sepsis_neonatal.db

# Groq Cloud API Infrastructure (High-Speed Inference Engine)
GROQ_MODEL_NAME=llama-3.1-8b-instant
GROQ_API_KEY=your_groq_api_key_here
LLM_API_BASE_URL=https://groq.com

# Emergency Clinical Communications (Twilio Telephony Router)
TWILIO_ACCOUNT_SID=your_twilio_sid_here
TWILIO_AUTH_TOKEN=your_twilio_token_here
TWILIO_CLINICAL_PHONE=+40700000000
TWILIO_TWILIO_PHONE=+10000000000
